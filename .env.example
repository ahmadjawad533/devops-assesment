# Application Environment
NODE_ENV=production
APP_VERSION=1.0.0
PORT=3000
LOG_LEVEL=info

# Database Configuration (use strong passwords in production)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=apex_ops

# Deployment Environment
ENVIRONMENT=local
REGION=us-east-1

# Secrets (should be provided via secure secret management)
# API_KEY=your-secure-key-here
# JWT_SECRET=your-jwt-secret-here
